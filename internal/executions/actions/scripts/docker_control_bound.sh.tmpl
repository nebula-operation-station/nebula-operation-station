#!/bin/sh
# docker.@VERB@ 1.1.0 (Nebula built-in, Docker, container update plan G5b):
# docker @VERB@ of the container that an approved batch binding names.
# Parameters, one line: {"container_id":"<64 hex>","image_id":"sha256:<64 hex>"}.
# Before the verb the script checks that the container with that full ID
# exists and that its image is the bound image ID. If not, it stops with the
# code container_changed and runs no verb. The verb acts on the ID, not on a
# name, so the check and the action refer to the same container. The
# configuration hash is deliberately not checked here (G4: the host cannot
# produce it). Nothing is recreated or pulled.
set -u
b64() { base64 -w0 2>/dev/null || base64 | tr -d '\n'; }
pre() { printf '{"format":"docker-control-v1","phase":"precheck","reason":"%s"}\n' "$1"; exit 10; }
changed() { printf '{"format":"docker-control-v1","phase":"precheck","code":"container_changed","reason":"%s"}\n' "$1"; exit 10; }
c=$(sed -n 's/^{"container_id":"\([0-9a-f]\{64\}\)","image_id":"sha256:[0-9a-f]\{64\}"}$/\1/p' "$NEBULA_PARAMS")
i=$(sed -n 's/^{"container_id":"[0-9a-f]\{64\}","image_id":"\(sha256:[0-9a-f]\{64\}\)"}$/\1/p' "$NEBULA_PARAMS")
[ -n "$c" ] && [ -n "$i" ] || pre "the container_id or image_id parameter is missing or invalid"
command -v docker >/dev/null 2>&1 || pre "Docker is not installed"
# Same access as docker.list: the docker group, else sudo -n (spec 08).
d="docker"
if [ "$(id -u)" -ne 0 ] && ! docker version --format '{{.Server.Version}}' >/dev/null 2>&1; then
	d="sudo -n docker"
fi
$d version --format '{{.Server.Version}}' >/dev/null 2>&1 ||
	pre "the Docker daemon is not reachable, or the SSH user may not use it (docker group or sudo)"
got=$($d inspect --type container --format '{{.Id}} {{.Image}}' -- "$c" 2>/dev/null) ||
	changed "the bound container no longer exists"
[ "$got" = "$c $i" ] ||
	changed "the container ID or image no longer matches the approved binding"
before=$($d inspect --type container --format '{{.State.Status}}' -- "$c" 2>/dev/null)
out=$($d @VERB@ -- "$c" 2>&1)
rc=$?
printf '%s\n' "$out" | head -c 4096 >&2
after=$($d inspect --type container --format '{{.State.Status}}' -- "$c" 2>/dev/null)
before=$(printf '%s' "$before" | head -c 100 | b64)
after=$(printf '%s' "$after" | head -c 100 | b64)
out=$(printf '%s' "$out" | head -c 4096 | b64)
printf '{"format":"docker-control-v1","phase":"done","verb":"@VERB@","container":"%s","exit":%d,"before":"%s","after":"%s","output":"%s"}\n' "$c" "$rc" "$before" "$after" "$out"
exit "$rc"
