#!/bin/sh
# docker.@VERB@ 1.0.0 (Nebula built-in, Docker): docker @VERB@ of one
# container, then its state. Parameter: {"container": "<name or ID>"}.
# Nothing is recreated or pulled.
set -u
b64() { base64 -w0 2>/dev/null || base64 | tr -d '\n'; }
pre() { printf '{"format":"docker-control-v1","phase":"precheck","reason":"%s"}\n' "$1"; exit 10; }
c=$(sed -n 's/^{"container":"\([A-Za-z0-9][A-Za-z0-9_.-]*\)"}$/\1/p' "$NEBULA_PARAMS")
[ -n "$c" ] || pre "the container parameter is missing or invalid"
command -v docker >/dev/null 2>&1 || pre "Docker is not installed"
# Same access as docker.list: the docker group, else sudo -n (spec 08).
d="docker"
if [ "$(id -u)" -ne 0 ] && ! docker version --format '{{.Server.Version}}' >/dev/null 2>&1; then
	d="sudo -n docker"
fi
$d version --format '{{.Server.Version}}' >/dev/null 2>&1 ||
	pre "the Docker daemon is not reachable, or the SSH user may not use it (docker group or sudo)"
before=$($d inspect --type container --format '{{.State.Status}}' -- "$c" 2>/dev/null) || pre "no such container"
out=$($d @VERB@ -- "$c" 2>&1)
rc=$?
printf '%s\n' "$out" | head -c 4096 >&2
after=$($d inspect --type container --format '{{.State.Status}}' -- "$c" 2>/dev/null)
before=$(printf '%s' "$before" | head -c 100 | b64)
after=$(printf '%s' "$after" | head -c 100 | b64)
out=$(printf '%s' "$out" | head -c 4096 | b64)
printf '{"format":"docker-control-v1","phase":"done","verb":"@VERB@","container":"%s","exit":%d,"before":"%s","after":"%s","output":"%s"}\n' "$c" "$rc" "$before" "$after" "$out"
exit "$rc"
