#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# postinst of the nebula-operation-station package. A first install only
# tells the admin how to configure it. An upgrade never restarts the
# services: the new binaries migrate the databases when they start, and
# the backup before that needs the admin's own sudo, which dpkg does not
# have (review m105). The services keep running the old version until the
# admin has made a backup and restarts them.
#
# Only install.sh knows the executor's flags, but the server drop-in is the
# same on every host, so an upgrade refreshes it here: it takes effect at the
# admin's restart, and the upgraded server can unlink what it imported. It
# must equal the one in install.sh (pinned by deploy/deb/postinst_test.go).
var_lib=/var/lib/nebula
systemd_dir=/etc/systemd/system
server_drop_in="${systemd_dir}/nebula-server.service.d/20-discovery.conf"

render_server_drop_in() {
  cat <<EOF
# Written by deploy/install.sh on every run; do not edit by hand.
# nebula-server queues discovery scans here (spec 12).
[Service]
ReadWritePaths=${var_lib}/discovery/jobs
# nebula-server writes the live want-list for nebula-pve-collector here
# (ADR 0006 P1-37); it never reads Proxmox itself.
ReadWritePaths=${var_lib}/pve/requests
# nebula-server unlinks the observations and guest NIC records it imported
# (ADR 0006 P1-10); without this the spool only grows.
ReadWritePaths=${var_lib}/pve/results
ReadWritePaths=${var_lib}/pve/guestnet
EOF
}

# provision_pve_spool creates what a version older than the drop-in did not:
# ReadWritePaths on a missing directory stops the unit (226/NAMESPACE). It
# converges the pve spool directories to install.sh's state - mode, owner
# and group - so an upgraded host ends with what install.sh would give
# them; a directory that already has that state is left alone. That also
# repairs what a collector unit left behind: with UMask=0077 and
# RestrictSUIDSGID=yes it cannot give its spool directories the setgid/group
# bits the server needs to list and unlink what it imported.
#
# Only root can fix the owner and group. The pve root is repaired as root
# with install -d -m -o -g, which follows a symlink, so it runs only when
# the root is absent or a real directory. Below the root, the owner and
# group are fixed as root with chown --no-dereference on a real directory,
# and the mode is re-applied as the collector: as root, a symlink swapped in
# there would redirect the mode change to its target.
#
# A file or symlink swapped in at the pve root or below it is not a
# directory the spool can use, and touching it could hand its target to the
# collector. It is left alone, link and target: the upgrade keeps the old
# drop-in and points the admin to install.sh.
provision_pve_spool() {
  if ! getent passwd nebula-pve-collector >/dev/null; then
    useradd --system --home-dir "${var_lib}/pve" --shell /usr/sbin/nologin -G nebula-rpc nebula-pve-collector || return 1
  fi
  # install -d follows a symlink, so it must not run on one: a link swapped
  # in at the pve root would hand its target to the collector. A file is
  # not a directory either. Both are left alone and skip the drop-in refresh.
  if [ -L "${var_lib}/pve" ] || { [ -e "${var_lib}/pve" ] && [ ! -d "${var_lib}/pve" ]; }; then
    return 1
  fi
  if [ "$(stat -c '%a %U %G' "${var_lib}/pve" 2>/dev/null)" = "2750 nebula-pve-collector nebula-rpc" ]; then
    :
  else
    install -d -m 2750 -o nebula-pve-collector -g nebula-rpc "${var_lib}/pve" || return 1
  fi
  for entry in results:2770 guestnet:2770 requests:2770 live:2750; do
    dir="${var_lib}/pve/${entry%:*}"
    mode="${entry#*:}"
    # The same guard as the pve root: install -d follows a symlink and
    # would re-apply the mode to its target, and a file is not a spool
    # directory. Both are left alone and skip the drop-in refresh.
    if [ -L "${dir}" ] || { [ -e "${dir}" ] && [ ! -d "${dir}" ]; }; then
      return 1
    fi
    state="$(stat -c '%a %U %G' "${dir}" 2>/dev/null)" || state=""
    if [ "${state}" = "${mode} nebula-pve-collector nebula-rpc" ]; then
      continue
    fi
    case "${state}" in
      ""|*"nebula-pve-collector nebula-rpc")
        # Absent (the collector creates it with the right owner and group)
        # or only the mode is wrong (the collector can chmod its own
        # directory).
        ;;
      *)
        # A wrong owner or group only root can fix. The guard above left
        # only a real directory, and --no-dereference keeps the chown from
        # following a link.
        if [ -d "${dir}" ]; then
          chown --no-dereference nebula-pve-collector:nebula-rpc "${dir}" || return 1
        fi
        ;;
    esac
    setpriv --reuid=nebula-pve-collector --regid=nebula-rpc --clear-groups \
      install -d -m "${mode}" "${dir}" || return 1
  done
}

# refresh_server_drop_in acts only where install.sh has run: without the
# drop-in the host is not configured yet. It never fails the upgrade: the old
# drop-in still lets the server start, the spool just keeps growing.
refresh_server_drop_in() {
  [ -f "${server_drop_in}" ] || return 0
  tmp="${server_drop_in}.dpkg-tmp"
  if provision_pve_spool && render_server_drop_in > "${tmp}" && chmod 0644 "${tmp}"; then
    if cmp -s "${tmp}" "${server_drop_in}"; then
      rm -f "${tmp}"
      return 0
    fi
    if mv -f "${tmp}" "${server_drop_in}"; then
      echo "nebula: updated ${server_drop_in}; it applies when nebula-server restarts."
      return 0
    fi
  fi
  rm -f "${tmp}"
  cat >&2 <<EOF
nebula: warning: could not update ${server_drop_in}; imported PVE spool files
nebula: stay until you run: sudo /usr/share/nebula/deploy/install.sh --from-package --admin-users USER --rp-id HOST
EOF
}

case "$1" in
  configure)
    if [ -z "$2" ]; then
      cat <<EOF
Nebula Operation Station is installed but not configured; its services do
not start until it is. Configure it with:

  sudo /usr/share/nebula/deploy/install.sh --from-package --admin-users USER --rp-id HOST

(see /usr/share/doc/nebula-operation-station/guide.md). For network discovery also: sudo apt install nmap
EOF
      exit 0
    fi
    refresh_server_drop_in
    [ -d /run/systemd/system ] || exit 0
    systemctl daemon-reload || true
    # The hint, never a restart: also when the executor is stopped or failed,
    # a running collector stays on the old binary until the admin restarts it.
    if ! systemctl is-active --quiet nebula-executor.service \
      && ! systemctl is-active --quiet nebula-pve-collector.service; then
      exit 0
    fi
    cat <<EOF
nebula: the new version is installed; the services keep running the old one.
nebula: back up, then restart (the new version migrates the databases):
nebula:   sudo nebula backup && sudo systemctl restart nebula-executor nebula-server nebula-pve-collector
nebula: then run nebula unlock.
EOF
    ;;
esac
exit 0
