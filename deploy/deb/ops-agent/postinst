#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# postinst of the nebula-ops-agent package (ADR 0016 D2, D13).
# It provisions what deploy/install.sh --ops-agent provisions for a tarball
# install: the agent's own system user, its state dir and its config dir with
# a skeleton configuration. It never enables or starts the agent, its timer
# or its path unit, on install or upgrade: the agent needs a NOS token and
# URL first, and the admin enables them (guide, "Ops agent"). An upgrade
# needs no restart either: every run is a new oneshot with the binary on
# disk.
#
# The skeleton must equal the one in install.sh (pinned by
# deploy/deb/ops_agent_pkg_test.go). A file or symlink at one of the paths
# is left alone (install -d would follow it) and the admin is warned; the
# package still configures, the agent just refuses to run until it is fixed.
ops_state_dir=/var/lib/nebula-ops-agent
ops_etc_dir=/etc/nebula-ops-agent

render_ops_config() {
  cat <<'EOF' # ops agent config skeleton
{
  "nos_base_url": "",
  "nos_token_file": "/etc/nebula-ops-agent/token",
  "state_dir": "/var/lib/nebula-ops-agent"
}
EOF
}

# not_a_dir PATH succeeds if PATH is a symlink or exists as something other
# than a directory.
not_a_dir() {
  [ -L "$1" ] || { [ -e "$1" ] && [ ! -d "$1" ]; }
}

# not_a_file PATH succeeds if PATH is a symlink or exists as something
# other than a regular file.
not_a_file() {
  [ -L "$1" ] || { [ -e "$1" ] && [ ! -f "$1" ]; }
}

warn_path() {
  cat >&2 <<EOF
nebula-ops-agent: warning: $1 is a file or a symlink where a $2 belongs; leaving it alone.
nebula-ops-agent: inspect it (ls -ld $1), remove it if it is not yours, then: sudo dpkg-reconfigure nebula-ops-agent
EOF
}

# provision_ops_agent creates the user (no supplementary group: not in
# nebula-rpc, the agent never talks to the executor), the state dir 0700
# owned by the agent, the config dir 0750 root:nebula-ops-agent and, only
# if absent, the skeleton 0640 root:nebula-ops-agent, so the agent can read
# but not change its configuration. No secret is created: the token and the
# optional LLM credential are files the admin puts into the config dir
# (0600, owned by the agent).
provision_ops_agent() {
  if ! getent passwd nebula-ops-agent >/dev/null; then
    useradd --system --home-dir "${ops_state_dir}" --shell /usr/sbin/nologin nebula-ops-agent || return 1
  fi
  if not_a_dir "${ops_state_dir}"; then
    warn_path "${ops_state_dir}" "directory"
    return 1
  fi
  if not_a_dir "${ops_etc_dir}"; then
    warn_path "${ops_etc_dir}" "directory"
    return 1
  fi
  if not_a_file "${ops_etc_dir}/config.json"; then
    warn_path "${ops_etc_dir}/config.json" "regular file"
    return 1
  fi
  install -d -m 0700 -o nebula-ops-agent -g nebula-ops-agent "${ops_state_dir}" || return 1
  install -d -m 0750 -o root -g nebula-ops-agent "${ops_etc_dir}" || return 1
  if [ ! -e "${ops_etc_dir}/config.json" ]; then
    tmp=$(mktemp) || return 1
    if render_ops_config > "${tmp}" \
      && install -m 0640 -o root -g nebula-ops-agent "${tmp}" "${ops_etc_dir}/config.json"; then
      rm -f "${tmp}"
    else
      rm -f "${tmp}"
      return 1
    fi
  fi
}

# check_ops_token reports a token the admin left readable by others. It
# never reads, moves or changes the file.
check_ops_token() {
  token="${ops_etc_dir}/token"
  if not_a_file "${token}"; then
    warn_path "${token}" "regular file"
    return 0
  fi
  if [ -f "${token}" ]; then
    mode=$(stat -c %a "${token}") || return 0
    if [ "${mode}" != "600" ]; then
      echo "nebula-ops-agent: warning: ${token} has mode ${mode}, want 600 (sudo chmod 600 ${token})" >&2
    fi
  fi
}

case "$1" in
  configure)
    provision_ops_agent || echo "nebula-ops-agent: warning: provisioning incomplete (see above); the agent will not run until it is fixed" >&2
    check_ops_token
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
    fi
    if [ -z "$2" ]; then
      cat <<EOF
nebula-ops-agent is installed; its timer and path unit are NOT enabled. Next steps
(guide, "Ops agent"):
  1. on the Nebula machine: nebula-server -api-token ops-agent:ops.read,ops.notes.write
     (add its server.json entry, source_addresses 127.0.0.1 and ::1, restart nebula-server),
     then put the token into ${ops_etc_dir}/token (0600, owned by nebula-ops-agent),
  2. set "nos_base_url" in ${ops_etc_dir}/config.json, e.g. "http://127.0.0.1:8080"
     (https, or http to a loopback IP; not localhost),
  3. allow the LLM address: sudo systemctl edit nebula-ops-agent.service
       [Service]
       IPAddressAllow=<LLM address>
     (a plain http LLM address must not have llm_credential_file set),
  4. sudo systemctl enable --now nebula-ops-agent.timer
     sudo systemctl enable --now nebula-ops-agent.path
EOF
    else
      echo "nebula-ops-agent: upgraded; the next run uses the new version (enable with: sudo systemctl enable --now nebula-ops-agent.timer; sudo systemctl enable --now nebula-ops-agent.path)"
    fi
    ;;
esac
exit 0
