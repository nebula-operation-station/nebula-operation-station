# Starts nebula-ops-agent.service when the server touches its trigger file:
# a finding newly entered tier critical or high, or an admin asked a
# question (ADR 0016 D3). The trigger carries no data. Only systemd reads
# this directory; it lies below /var/lib/nebula, which the agent's unit
# makes inaccessible to the agent (D13). Off by default (guide, "Ops agent"):
#   sudo systemctl enable --now nebula-ops-agent.path
# The trigger is inert for now: nebula-server runs with ProtectSystem=strict and may write
# only its StateDirectory (/var/lib/nebula/server), so nothing touches the
# trigger yet. Until a follow-up gives nebula-server a write path for
# /var/lib/nebula/opsagent, only the timer starts runs.
[Unit]
Description=Nebula Operation Station ops agent: watch the server's trigger

[Path]
PathChanged=/var/lib/nebula/opsagent/trigger
Unit=nebula-ops-agent.service

[Install]
WantedBy=multi-user.target
