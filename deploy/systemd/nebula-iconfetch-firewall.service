# Mandatory firewall setup for nebula-iconfetch (ADR 0009 D6, TM16b).
# Separate from the unprivileged helper: root needs only CAP_NET_ADMIN to
# apply the root-owned nftables file. Failure prevents helper startup.
# The batch atomically replaces ONLY this helper's table and can be rerun.
# Keep the rules after stop: removing them could open an egress window.
# Stop the helper before manually changing/removing rules or deleting its
# account. Do not reuse its UID.
#
# Host firewall reloads: a `flush ruleset` (nftables.service) deletes this
# table. PartOf= stops/restarts this unit with nftables.service or
# firewalld.service (and BindsTo= then stops the helper); ReloadPropagatedFrom=
# reapplies the table after their reloads. Anything else that flushes the
# ruleset is caught by the helper's ExecStartPre table check, which refuses
# to start the helper until this unit is restarted.
[Unit]
Description=Nebula Operation Station icon fetcher egress firewall
After=nftables.service firewalld.service
PartOf=nftables.service firewalld.service
ReloadPropagatedFrom=nftables.service firewalld.service
Before=nebula-iconfetch.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
ExecStart=/usr/sbin/nft -f /etc/nebula/nebula-iconfetch.nft
ExecReload=/usr/sbin/nft -f /etc/nebula/nebula-iconfetch.nft
TimeoutStartSec=15s
MemoryMax=64M
TasksMax=8
UMask=0077

LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
InaccessiblePaths=-/var/lib/nebula -/run/nebula
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
# Netlink is used to install nftables rules; no Internet sockets are needed.
RestrictAddressFamilies=AF_NETLINK
