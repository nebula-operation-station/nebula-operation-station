# SPDX-License-Identifier: AGPL-3.0-or-later
# Reference unit for nebula-netdev-collector (ADR 0010, ND-15). The collector
# polls the executor over the shared Unix socket for the registered network
# devices (ListNetDevices) and their typed reads (ReadNetDevice), and writes
# the sanitized results to the spool under /var/lib/nebula/netdev. It never
# talks to a device itself: the executor does.
#
# It runs as its own system user (nebula-netdev-collector) with the
# netdev-collector peercred role, and is locked down like the PVE collector:
# no capabilities, and no network at all (AF_UNIX only, for the executor
# socket). It never mounts or reads the executor's database or credentials —
# the spool is its only writable path, and it only gets what the
# netdev-collector role allows.
#
# Off by default: install.sh and the package install this unit but never
# enable or start it. Nothing in this release imports or removes the spool
# files yet; the server import comes with ND-16 (ADR 0010). Until then an
# enabled collector writes a new file of up to 1 MiB per device and read on
# every interval, and the spool grows without bound on the filesystem it
# shares with the executor database. Enable it only once the server import
# (ND-16) is installed and the network devices are registered in the
# executor:
#   systemctl enable --now nebula-netdev-collector
[Unit]
Description=Nebula Operation Station network device collector
Documentation=https://github.com/nebula-operation-station/nebula-operation-station/tree/main/docs
After=nebula-executor.service
Wants=nebula-executor.service

[Service]
Type=simple
User=nebula-netdev-collector
Group=nebula-netdev-collector
# nebula-rpc: connect to /run/nebula/executor.sock (SO_PEERCRED, group rw)
# and share the spool with the server (internal/netdevcollect/spool.go).
SupplementaryGroups=nebula-rpc
ExecStart=/usr/bin/nebula-netdev-collector \
  -socket /run/nebula/executor.sock \
  -executor-user nebula-executor \
  -spool /var/lib/nebula/netdev \
  -interval 1m
Restart=on-failure
# Keep retrying while the executor restarts (for example during an
# upgrade); the default 100 ms burst gives up after five tries.
RestartSec=5s
UMask=0077

# Hardening
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
# Unix socket for the executor RPC only. No AF_INET/AF_INET6: the collector
# has no network listener and no outbound network (ADR 0010 D4).
RestrictAddressFamilies=AF_UNIX
# The spool is the only writable path; the executor socket is reached
# through the nebula-rpc group. install.sh provisions it (2770,
# nebula-netdev-collector:nebula-rpc); RestrictSUIDSGID keeps the collector
# from setting the setgid bit itself.
ReadWritePaths=/var/lib/nebula/netdev

[Install]
WantedBy=multi-user.target
